# Rendimiento: caché y compresión de archivos estáticos.
#
# CSS y JS se referencian con número de versión (styles.css?v=4), así que
# el navegador puede guardarlos mucho tiempo: cuando cambian, se sube la
# versión en el HTML y se descargan de nuevo. Los HTML no se cachean para
# que siempre apunten a la última versión.

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpe?g|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Compresión gzip (se activa si el servidor tiene mod_deflate habilitado)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
